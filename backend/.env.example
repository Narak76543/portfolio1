# SARAT NARAK Backend — Environment Variables Example
# Duplicate this file as .env for local development or configure in FastAPI Cloud environment settings

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Comma-separated CORS origins (add your Vercel production domains when deploying)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
