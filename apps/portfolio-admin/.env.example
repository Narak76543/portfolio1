# SARAT NARAK Portfolio Admin Panel — Environment Variables Example
# Duplicate as .env for local dev or configure in Vercel environment settings

NUXT_PUBLIC_API_BASE_URL=http://localhost:8000
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Set to your live admin domain in Vercel (e.g. https://admin.saratnarak.com) to enable QR Code Device-Approval Login
NUXT_PUBLIC_APP_URL=
